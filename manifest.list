# manifest.list: which files are secret and/or machine-specific, and where to link them.
# Read by ./secrets (encryption) and bin/link-manifest (symlinks). Not by dotbot.
#
# Columns (whitespace separated):   <path in repo>   <link target or ->   <secret or ->
#
#   path    relative to the repo root. `{hostname}` = lowercase `hostname -s`, so each machine only
#           uses its own file. A `*` matches several files (e.g. funk/*.json).
#   target  where bin/link-manifest symlinks it (`~` ok). For a `*` row it is a directory that gets one link
#           per file. `-` = not linked here (dotbot links it, e.g. whole folders like ~/.aws in install.conf.yaml).
#   secret  gitignored plaintext, only <file>.age is committed. ./secrets encrypts/decrypts it and adds
#           the .gitignore pattern itself. `-` = tracked as is (e.g. a per-machine file that is not sensitive).
#
# So a secret file is listed once, here, and nowhere else. Examples:
#   aws/config                       -                     secret   # secret inside a folder dotbot already links
#   taskrc                           ~/.taskrc             secret   # secret file, linked by link-manifest
#   funk/*.json                      ~/.funk_rsync.d       secret   # many files into one directory
#   config/APP/app.{hostname}.ini    ~/.config/APP/app.ini secret   # per machine, secret
#   config/digikamrc.{hostname}      ~/.config/digikamrc   -        # per machine, public
#
# New machine:  cp <target> <repo path with this host>;  ./secrets encrypt;  commit;  ./install

# --- fixed secrets ---
aws/config                                      -                                       secret
aws/credentials                                 -                                       secret
config/beets/discogs_token.json                 -                                       secret
config/beets/spotify_token.json                 -                                       secret
config/funk-send/config.json                    ~/.config/funk-send/config.json         secret
config/passhole.ini                             ~/.config/passhole.ini                  secret
config/rclone/rclone.conf                       -                                       secret
config/redlist/spotify_token.json               -                                       secret
funk/*.json                                     ~/.funk_rsync.d                         secret
hosts                                           -                                       secret
pgadmin/pgpass                                  ~/.pgpass                               secret
pgadmin/pgpass_encrypted.tar                    -                                       secret
ssh/config                                      ~/.ssh/config                           secret
taskrc                                          ~/.taskrc                               secret
whatlastgenre/config                            -                                       secret

# --- per-machine configs ---
config/Nextcloud/nextcloud.{hostname}.cfg       ~/.config/Nextcloud/nextcloud.cfg       secret
config/joplin-desktop/settings.{hostname}.json  ~/.config/joplin-desktop/settings.json  secret
config/digikamrc.{hostname}                     ~/.config/digikamrc                     -
config/darktable/darktablerc.{hostname}         ~/.config/darktable/darktablerc         -
