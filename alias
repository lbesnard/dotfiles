# Quick directory archiving with size warning
archive_dir() {
    local threshold=1048576 # 1GB in Kilobytes
    local target="${1%/}"
    local date_stamp=$(date +%Y-%m-%d)

    if [[ -z "$target" ]]; then
        echo "Usage: archive <directory>"
        return 1
    fi

    if [[ ! -d "$target" ]]; then
        echo "Error: '$target' is not a directory."
        return 1
    fi

    local dir_kb=$(du -sk "$target" | cut -f1)

    if (( dir_kb > threshold )); then
        local human_size=$(du -sh "$target" | cut -f1)
        echo "Warning: '$target' is $human_size."
        echo -n "Proceed with compression? (y/n): "
        read -r response
        if [[ "$response" != "y" ]]; then
            echo "Cancelled."
            return 0
        fi
    fi

    local archive_name="${target}_${date_stamp}.tar.gz"
    echo "Creating $archive_name..."
    tar -czf "$archive_name" "$target" && echo "Done: $archive_name"
}

