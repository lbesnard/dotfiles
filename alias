# yazi wrapper
y() {
    local config_file="$HOME/.config/yazi/package.toml"
    local plugins_dir="$HOME/.config/yazi/plugins"
    local missing=0

    if [[ -f "$config_file" ]]; then
        if [[ ! -d "$plugins_dir" ]]; then
            missing=1
        else
            local -a declared_plugins
            declared_plugins=("${(@f)$(grep -E '^[[:space:]]*use[[:space:]]*=' "$config_file" | sed -E 's/.*"([^"]+)".*/\1/')}")

            for plugin in "${declared_plugins[@]}"; do
                local name="${plugin##*/}"
                name="${name#*:}"

                if [[ ! -f "$plugins_dir/${name}.yazi/main.lua" ]]; then
                    missing=1
                    break
                fi
            done
        fi

        if [[ $missing -eq 1 ]]; then
            echo "Yazi plugins missing or incomplete. Installing..."
            ya pkg install
        fi
    fi

    local tmp cwd
    tmp="$(mktemp -t "yazi-cwd.XXXXXX")" || return
    command yazi --cwd-file="$tmp" "$@"
    local ret=$?
    if cwd="$(command cat -- "$tmp")" && [[ -n "$cwd" && "$cwd" != "$PWD" ]]; then
        builtin cd -- "$cwd"
    fi
    command rm -f -- "$tmp"
    return $ret
}

