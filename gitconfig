[core]
    editor   = nvim
    pager = delta
    #pager = diff-so-fancy | less --tabs=4 -RFX
    #autocrlf = true
[interactive]
    diffFilter = delta --color-only --features=interactive
#	diffFilter = diff-so-fancy --patch

[user]
    name  = lbesnard
    email = laurent.besnard@utas.edu.au
[credential]
    helper = cache --timeout=36000
[status]
  showUntrackedFiles = all

[log]
    page = delta

#[diff]
#    pager = diff-so-fancy | less --tabs=4 -RFX
[merge]
    conflictstyle = diff3
[delta]
    navigate = true  # use n and N to move between diff sections
    light = false    # set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)
    features = decorations
    minus-style = syntax bold auto
[delta "interactive"]
    keep-plus-minus-markers = false

[delta "decorations"]
    commit-decoration-style = blue ol
    commit-style = raw
    file-style = omit
    hunk-header-decoration-style = blue box
    hunk-header-file-style = red
    hunk-header-line-number-style = "#067a00"
    hunk-header-style = file line-number syntax
[color]
	ui = always
    branch      = auto
    diff        = auto
    interactive = auto
    status      = auto

[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green
[color "diff"]
	meta = 11
	frag = magenta bold
	old = red bold
	new = green bold
	func = 146 bold
	commit = yellow bold
	whitespace = red reverse
[color "status"]
    added = yellow
    changed = green
    untracked = cyan
#
# http://haacked.com/archive/2014/07/28/github-flow-aliases/
[alias]
    # Compact graph log
    lol = log --graph --decorate --pretty=oneline --abbrev-commit
    # Compact graph log, all branches
    lola = log --graph --decorate --pretty=oneline --abbrev-commit --all
    # Stash save
    ss = stash save
    # Stash pop
    sp = stash pop
    #s = status -uno
    # Status incl. untracked files
    s = status -u
    # Add
    a = add
    # Pull
    p = pull
    # Branch
    b = branch
    # Diff
    d = diff
    # Log
    l = log
    # Commit as 'wip'
    co-wip = !git commit -m 'wip'
    # Print HEAD commit hash
    hash = !git log -1 --format=format:'%H'
    # Pretty one-line history with dates
    hist = log --pretty=format:\"%h %ad | %s%d [%an]\" --graph --date=short
    # Checkout
    co = checkout
    # Amend last commit without editing message
    cane = commit --amend --no-edit
    # Safer force push
    fp = push --force-with-lease
    # Push new branch and set upstream
    pu = push -u origin HEAD
    # Diff of staged changes
    ds = diff --staged
    # Short status with branch
    st = status -sb
    # Show last commit with stats
    last = log -1 --stat
    # Unstage files
    unstage = reset HEAD --
    # Cherry-pick
    cp = cherry-pick
    # Interactive rebase
    rbi = rebase -i
    # Rebase onto latest origin/main
    rbm = !git fetch origin && git rebase origin/main
    # Branches by recent commit with tracking info
    br = branch --sort=-committerdate -vv
    # Commit counts by author
    contributors = shortlog -sn
    # Stash only unstaged changes
    stash-unstaged = stash --keep-index
    # Default branch name: origin/HEAD, else local main, else local master
    default-branch = "!f() { b=$(git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null); b=${b#origin/}; if [ -z \"$b\" ]; then for c in main master; do git show-ref -q --verify refs/heads/$c && b=$c && break; done; fi; [ -n \"$b\" ] && echo \"$b\"; }; f"
    # Checkout default branch, fetch all remotes ONCE (one ssh auth per remote), fast-forward, delete merged branches
    com = "!f() { b=$(git default-branch) || { echo 'No default branch found'; return 1; }; git checkout \"$b\" && git fetch --all --prune && { if git rev-parse --abbrev-ref @{u} >/dev/null 2>&1; then git merge --ff-only @{u}; fi; } && git bclean \"$b\"; }; f"
    # Fetch and checkout PR by number
    co-pr = !sh -c 'git fetch origin pull/$1/head:pr/$1 && git checkout pr/$1' -
    # WIP commit then squash-auto
    co-wip-and-squash-last = !git co-wip && git squash-auto
    # Soft-reset N commits and recommit with combined messages
    squash-auto = !"f(){ git reset --soft HEAD~${1} && git commit --edit -m\"$(git log --format=%B --reverse HEAD..HEAD@{1})\"; };f"
    # Force-push current branch to origin
    push-force-branch = push -f origin HEAD
    # Push current branch to origin
    push-branch = push origin HEAD
    # WIP commit and push current branch
    co-wip-and-push-branch = !git co-wip && git push-branch
    # Interactive rebase squashing last N commits
    squash-last = !"f() { NL=$1; GIT_EDITOR=\"sed -i '2,$NL s/pick/squash/;/# This is the 2nd commit message:/,$ {d}'\"; git rebase -i HEAD~$NL; }; f"
    # Edit global git config
    ec = config --global -e
    # Pull --rebase --prune and update submodules
    up = !git pull --rebase --prune $@ && git submodule update --init --recursive
    # Checkout new branch
    cob = checkout -b
    # Add all and commit with message
    cm = !git add -A && git commit -m
    # Add all and commit as SAVEPOINT
    save = !git add -A && git commit -m 'SAVEPOINT'
    # Add tracked changes and commit as WIP
    wip = !git add -u && git commit -m "WIP"
    # Undo last commit, keep changes
    undo = reset HEAD~1 --mixed
    # Amend last commit with all changes
    amend = commit -a --amend
    # Discard all changes (kept in a WIPE SAVEPOINT commit)
    wipe = !git add -A && git commit -qm 'WIPE SAVEPOINT' && git reset HEAD~1 --hard
    # Delete branches merged into main (or given branch)
    bclean = "!f() { b=${1:-$(git default-branch)}; git branch --merged \"$b\" --format='%(refname:short)' | grep -vxF \"$b\" | xargs -r git branch -d; }; f"
    # Checkout main/given branch, update, clean merged branches
    bdone = "!f() { b=${1:-$(git default-branch)}; git checkout \"$b\" && git up && git bclean \"$b\"; }; f"
    # Hard-reset current branch to origin
    reset-branch-like-remote = "!f() { git fetch origin && git reset --hard origin/$(git branch --show-current); }; f"
    # gh repo sync current branch, keeping local changes stashed/popped
    sync-and-stash = "!f() { git stash push --all -q && gh repo sync --branch \"$(git branch --show-current)\"; r=$?; git stash pop -q; return $r; }; f"
[color "diff-highlight"]
	oldNormal = red bold
	oldHighlight = red bold 52
	newNormal = green bold
	newHighlight = green bold 22
[diff-so-fancy]
	markEmptyLines = false
	changeHunkIndicators = false
	stripLeadingSymbols = false
