---
# Homepage configuration
# See https://fontawesome.com/icons for icons options

title: "Brownfunk"
#subtitle: "Home server"
#logo: ""
# Alternatively a fa icon can be provided:
# icon: "fas fa-skull-crossbones"

header: False # Set to false to hide the header
footer: '<p>Created with <span class="has-text-danger">❤️</span>. Click on  <a href="http://10.1.1.198:3000/s/H1tA_LShH" target="_blank">Server How to</a> to understand how to get by.</i></a></p>' # set false if you want to hide it.header:

# Optional theming
#theme: default # 'default' or one of the theme available in 'src/assets/themes'.

theme: dark
colors:
  dark:
    highlight-primary: "#2b2b2b"
    highlight-secondary: "#484d54"
    highlight-hover: "#cfdfae"
    background: "#1313134a"
    card-background: "#2b2b2b"
    text: "#cadfae"
    text-header: "#cfdfae"
    text-title: "#cfdfae"
    text-subtitle: "#cfdfae"
    card-shadow: rgba(0, 0, 0, 0.4)
    link-hover: "#cfdfae"
  light:
    highlight-primary: "#2b2b2b"
    highlight-secondary: "#484d54"
    highlight-hover: "#cfdfae"
    background: "#1313134a"
    card-background: "#2b2b2b"
    text: "#cadfae"
    text-header: "#cfdfae"
    text-title: "#cfdfae"
    text-subtitle: "#cfdfae"
    card-shadow: rgba(0, 0, 0, 0.4)
    link-hover: "#cfdfae"
 # light:
    #highlight-primary: "#3367d6"
    #highlight-secondary: "#4285f4"
    #highlight-hover: "#5a95f5"
    #background: "#f5f5f5"
    #card-background: "#ffffff"
    #text: "#363636"
    #text-header: "#424242"
    #text-title: "#303030"
    #text-subtitle: "#424242"
    #card-shadow: rgba(0, 0, 0, 0.1)
    #link-hover: "#363636"

# Optional message
message:
  # url: "https://<my-api-endpoint>" # Can fetch information from an endpoint to override value below.
  style: "is-warning"
  title: "Welcome to Brownfunk!!"
  content: '<a href="http://brownfunk.lan/home">brownfunk.lan/home</a> <br> Find more information at <a href="http://10.1.1.198:3000/s/H1tA_LShH" target="_blank">Server How to</a>'

# Optional navbar
# links: [] # Allows for navbar (dark mode, layout, and search) without any links
links:
#  - name: "Github"
    #icon: "fab fa-github"
    #url: "https://github.com/lbesnard"
#    target: "_blank" # optional html tag target attribute
  - name: "Server Howto"
    icon: "fas fa-book"
    #logo: "assets/alert.png"
    url: "http://10.1.1.198:3000/s/H1tA_LShH"
    target: "_blank" # optional html tag target attribute

# Services
# First level array represent a group.
# Leave only a "items" key if not using group (group name, icon & tagstyle are optional, section separation will not be displayed).
services:
