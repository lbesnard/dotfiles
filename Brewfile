# Core CLI tools for any machine (no sudo needed). Installed by initsys.sh via:
#   zb bundle install -f Brewfile
# Add / remove with:  zb install <formula>   then   zb bundle dump -f Brewfile --force

# shell
brew "zsh"
brew "tmux"
brew "starship"
brew "zoxide"
brew "fzf"

# search / files
brew "fd"
brew "ripgrep"
brew "bat"
brew "eza"
brew "yazi"
brew "jq"

# git
brew "git"
brew "age"
brew "pre-commit"
brew "gh"
brew "tig"
brew "git-delta"

# editor / misc
brew "neovim"
