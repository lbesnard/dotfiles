# i3blocks config. Scripts live in ~/.config/i3blocks/scripts/
# Reload: Mod+Shift+R.  Signals: volume=RTMIN+1, brightness=RTMIN+2 (sent by i3 keybindings)
align=center
separator=true
color=#ffffff
separator_block_width=10
markup=pango

[battery]
command=~/.config/i3blocks/scripts/battery
interval=30
color=#ff79c6

[bandwidth]
command=~/.config/i3blocks/scripts/bandwidth
interval=2
color=#8be9fd

[ip]
command=~/.config/i3blocks/scripts/ip
interval=30
label=
color=#bd0202

[wifi]
command=~/.config/i3blocks/scripts/wifi
interval=10
color=#bdb637

[bfunk-vpn]
command=~/.config/i3blocks/scripts/vpn bfunk brownfunk
interval=10

[utas-vpn]
command=pgrep -f 'vpnc.*utas_vpnc.conf' >/dev/null && echo " UTAS" || echo " UTAS"
interval=10

[cpu]
command=~/.config/i3blocks/scripts/cpu
interval=3

[disk]
command=~/.config/i3blocks/scripts/disk
interval=60

[cpu-temperature]
command=~/.config/i3blocks/scripts/temperature
interval=5

[memory]
command=~/.config/i3blocks/scripts/memory
interval=5

[volume]
command=~/.config/i3blocks/scripts/volume
interval=once
signal=1

[backlight]
command=~/.config/i3blocks/scripts/brightness
label= 
interval=once
signal=2
color=#eddd00

[date]
command=~/.config/i3blocks/scripts/date
interval=10
label= 

[power]
command=~/.config/i3blocks/scripts/power
interval=once
