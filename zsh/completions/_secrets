#compdef secrets ./secrets
# zsh completion for the `secrets` script of these dotfiles (age-encrypted secrets).
# Lives in zsh/completions, which is on $fpath via ~/.zsh_complete. `secrets install-completion` sets it up elsewhere.

_secrets() {
  local -a cmds
  cmds=(
    'status:key, hooks and state of every secret'
    'encrypt:re-encrypt changed plaintext secrets'
    'decrypt:write plaintext from the .age files'
    'check:pre-commit guard for staged files'
    'install-hook:install the git hooks'
    'install-completion:install this zsh completion'
    'bootstrap:install tools and paste the age key'
  )
  if (( CURRENT == 2 )); then
    _describe -t commands 'secrets command' cmds
    return
  fi
  case $words[2] in
    encrypt) _arguments \
      '--stage[git add the .age files and stop once (pre-commit framework)]' \
      '--add[git add the .age files and carry on (plain git hook)]' \
      '--force[re-encrypt even when there is no key to compare with]' ;;
    decrypt) _arguments \
      '--force[overwrite local edits]' \
      '--quiet[silent without a key (git hooks)]' ;;
    check) _files ;;
  esac
}

_secrets "$@"
