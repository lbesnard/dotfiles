# ==============================================
# ZSH Fast Startup Optimized .zshrc
# ==============================================

# Non-interactive shells (e.g. `ssh host` without -t, scp, sftp) must not run
# any of the interactive UI setup below — it calls tput/ncurses and will fail.
[[ $- != *i* ]] && return

# -----------------------------
# Zinit bootstrap
# -----------------------------
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
[ ! -d $ZINIT_HOME ] && mkdir -p "$(dirname $ZINIT_HOME)"
[ ! -d $ZINIT_HOME/.git ] && git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
source "${ZINIT_HOME}/zinit.zsh"

# Skip Ubuntu global compinit to speed up
skip_global_compinit=1
autoload -Uz _zinit
(( ${+_comps} )) && _comps[zinit]=_zinit

# -----------------------------
# Basic Environment
# -----------------------------
export PATH="$HOME/.local/bin:$PATH"
# dotfiles scripts (git-alias, gh-aliases, ...); needed on every machine
[[ -d "$HOME/bin" && ":$PATH:" != *":$HOME/bin:"* ]] && export PATH="$HOME/bin:$PATH"
export LANGUAGE="en_AU:en"
export LANG="en_IE.UTF-8"

# -----------------------------
# zerobrew (https://zerobrew.rs): PATH + CA certs. Lives here (not written by its installer)
# so every machine gets it; initsys.sh installs zerobrew with --no-modify-path.
# -----------------------------
if [[ -d "${XDG_DATA_HOME:-$HOME/.local/share}/zerobrew" || -d /opt/zerobrew ]]; then
  # zerobrew
  export ZEROBREW_DIR="${HOME}/.zerobrew"
  export ZEROBREW_BIN="${HOME}/.zerobrew/bin"
  export ZEROBREW_ROOT="${HOME}/.local/share/zerobrew"
  export ZEROBREW_PREFIX="${HOME}/.local/share/zerobrew/prefix"
  export PKG_CONFIG_PATH="$ZEROBREW_PREFIX/lib/pkgconfig:${PKG_CONFIG_PATH:-}"

  # SSL/TLS certificates (only if ca-certificates is installed)
  if [ -z "${CURL_CA_BUNDLE:-}" ] || [ -z "${SSL_CERT_FILE:-}" ]; then
    if [ -f "$ZEROBREW_PREFIX/opt/ca-certificates/share/ca-certificates/cacert.pem" ]; then
      [ -z "${CURL_CA_BUNDLE:-}" ] && export CURL_CA_BUNDLE="$ZEROBREW_PREFIX/opt/ca-certificates/share/ca-certificates/cacert.pem"
      [ -z "${SSL_CERT_FILE:-}" ] && export SSL_CERT_FILE="$ZEROBREW_PREFIX/opt/ca-certificates/share/ca-certificates/cacert.pem"
    elif [ -f "$ZEROBREW_PREFIX/etc/ca-certificates/cacert.pem" ]; then
      [ -z "${CURL_CA_BUNDLE:-}" ] && export CURL_CA_BUNDLE="$ZEROBREW_PREFIX/etc/ca-certificates/cacert.pem"
      [ -z "${SSL_CERT_FILE:-}" ] && export SSL_CERT_FILE="$ZEROBREW_PREFIX/etc/ca-certificates/cacert.pem"
    elif [ -f "$ZEROBREW_PREFIX/etc/openssl/cert.pem" ]; then
      [ -z "${CURL_CA_BUNDLE:-}" ] && export CURL_CA_BUNDLE="$ZEROBREW_PREFIX/etc/openssl/cert.pem"
      [ -z "${SSL_CERT_FILE:-}" ] && export SSL_CERT_FILE="$ZEROBREW_PREFIX/etc/openssl/cert.pem"
    elif [ -f "$ZEROBREW_PREFIX/share/ca-certificates/cacert.pem" ]; then
      [ -z "${CURL_CA_BUNDLE:-}" ] && export CURL_CA_BUNDLE="$ZEROBREW_PREFIX/share/ca-certificates/cacert.pem"
      [ -z "${SSL_CERT_FILE:-}" ] && export SSL_CERT_FILE="$ZEROBREW_PREFIX/share/ca-certificates/cacert.pem"
    fi
  fi

  if [ -z "${SSL_CERT_DIR:-}" ]; then
    if [ -d "$ZEROBREW_PREFIX/etc/ca-certificates" ]; then
      export SSL_CERT_DIR="$ZEROBREW_PREFIX/etc/ca-certificates"
    elif [ -d "$ZEROBREW_PREFIX/etc/openssl/certs" ]; then
      export SSL_CERT_DIR="$ZEROBREW_PREFIX/etc/openssl/certs"
    elif [ -d "$ZEROBREW_PREFIX/share/ca-certificates" ]; then
      export SSL_CERT_DIR="$ZEROBREW_PREFIX/share/ca-certificates"
    fi
  fi

  # Helper function to safely append to PATH
  _zb_path_append() {
      local argpath="$1"
      case ":${PATH}:" in
          *:"$argpath":*) ;;
          *) export PATH="$argpath:$PATH" ;;
      esac;
  }

  _zb_path_append "$ZEROBREW_BIN"
  _zb_path_append "$ZEROBREW_PREFIX/sbin"
  _zb_path_append "$ZEROBREW_PREFIX/bin"
fi

# Homebrew prefix detection
if [[ -d $HOME/.linuxbrew ]]; then
    export HOMEBREW_PREFIX=$HOME/.linuxbrew
elif [[ -d /home/linuxbrew ]]; then
    export HOMEBREW_PREFIX=/home/linuxbrew/.linuxbrew
fi
test -d "$HOMEBREW_PREFIX" && PATH="$HOMEBREW_PREFIX/bin:$HOMEBREW_PREFIX/sbin:$PATH"
# Set SHELL after prefix is known
export SHELL="${HOMEBREW_PREFIX:+$HOMEBREW_PREFIX/bin/zsh}"
[[ -z $SHELL || ! -x $SHELL ]] && export SHELL=$(command -v zsh)

# History
export HISTSIZE=32768
export HISTFILESIZE=$HISTSIZE
export HISTFILE=$HOME/.zsh_history
setopt append_history hist_expire_dups_first hist_ignore_all_dups hist_reduce_blanks hist_save_no_dups hist_lex_words hist_fcntl_lock

# -----------------------------
# pyenv
# -----------------------------
export PYENV_ROOT="$HOME/.pyenv"
PATH="$PYENV_ROOT/bin:$PATH"
# eval "$(pyenv init --path)"

# -----------------------------
# TMUX autostart (as early as possible)
# -----------------------------
# The OMZ tmux plugin runs tmux in the foreground of THIS shell (and exits with it),
# so everything loaded after it would be wasted work in the outer shell. Load it first;
# the real init then happens once, inside tmux ($TMUX set => plugin is a no-op).
# Only for local terminals (not SSH). Without -t 0, a plain `ssh host` (no PTY) would
# also satisfy -z SSH_TTY and crash.
if [[ -z "${SSH_TTY}" && -t 0 ]]; then
    if (( $+commands[tmux] )) && [[ -z $TMUX ]]; then
        # Guard against a stale/corrupted tmux server socket. If the server is
        # unresponsive, ZSH_TMUX_AUTOQUIT=true would close the terminal instantly
        # when tmux fails to connect. Kill the stale server first.
        # exit 0 -> healthy server; "no server" -> socket never existed (safe);
        # anything else (connection refused, timeout 124, ...) -> stale socket.
        _tmux_out=$(timeout 3 tmux ls 2>&1); _tmux_rc=$?
        if (( _tmux_rc != 0 )) && [[ "$_tmux_out" != *"no server"* ]]; then
            tmux kill-server 2>/dev/null
        fi
        unset _tmux_out _tmux_rc

        # Prune dead/unattachable sessions in background.
        (
          tmux list-sessions 2>/dev/null | while IFS= read -r line; do
              sess="${line%%:*}"
              tmux has-session -t "$sess" 2>/dev/null || tmux kill-session -t "$sess" 2>/dev/null
          done
        ) &!
    fi
    ZSH_TMUX_AUTOSTART=true
    ZSH_TMUX_AUTOCONNECT=true
    ZSH_TMUX_FIXTERM=false
    ZSH_TMUX_AUTOQUIT=true
    (( $+commands[tmux] )) && zinit lucid for OMZP::"tmux"
fi

# -----------------------------
# Prompt — Starship
# Installed binary (brew/nix/...): cache `starship init` keyed on the binary's mtime
# (saves a fork+exec per shell). Otherwise let zinit install it.
# -----------------------------
if (( $+commands[starship] )) && [[ ! -f "${ZINIT[PLUGINS_DIR]}/starship---starship/init.zsh" ]]; then
    _sp_cache="$HOME/.cache/zsh/starship_init.zsh"
    if [[ ! -s $_sp_cache || ${commands[starship]} -nt $_sp_cache ]]; then
        mkdir -p "${_sp_cache:h}"
        starship init zsh --print-full-init >| "$_sp_cache"
    fi
    source "$_sp_cache"
    unset _sp_cache
else
    zinit ice as"command" from"gh-r" atclone"./starship init zsh > init.zsh; ./starship completions zsh > _starship" atpull"%atclone" src"init.zsh"
    zinit light starship/starship
fi

# -----------------------------
# Colors & terminal settings
# -----------------------------
export CLICOLOR=1
export BLOCK_SIZE=human-readable # https://www.gnu.org/software/coreutils/manual/html_node/Block-size.html

# Only load terminal colour plugins when a real TTY is attached.
# zsh-256color calls tput which requires a real terminal — loading it via zinit's
# async turbo worker (wait"N") fails because the worker is a background process
# where isatty(stdin) is false. Load synchronously to keep it in the main shell.
if [[ -t 1 ]]; then
    zinit light "chrissicool/zsh-256color"
    [[ -s "$HOMEBREW_PREFIX/etc/grc.zsh" ]] && source $HOMEBREW_PREFIX/etc/grc.zsh
fi

rename_tmux_pane() {
    [[ -n $TMUX_PANE ]] || return
    tmux select-pane -T "${1:-$(fc -ln -1 | awk '{print $1}')}" -t "$TMUX_PANE"
}

preexec() {
    rename_tmux_pane "$1"
}

# -----------------------------
# Zsh options
# -----------------------------
setopt prompt_subst
setopt nomatch

# inherit aliases completion
# https://unix.stackexchange.com/questions/177902/zsh-completion-on-the-second-command-or-after-an-alias/178054#178054
unsetopt complete_aliases


# -----------------------------
# zsh functions autoload (lazy)
# -----------------------------
fpath=(~/.zsh_functions ~/.zsh_complete "${fpath[@]}")
autoload -Uz history-search-end cani vmc vmi lps kp fp bip bup bcp tmuxify utils ll lx
typeset -U PATH fpath

# Source local function files directly (faster than zinit snippet loop)
# Exclude server-only files (pipelines, imos_ardc) — loaded in zshrc.server
_server_only=(pipelines.zsh imos_ardc.zsh)
for _file in $HOME/.zsh_functions/*.zsh; do
  [[ -r "$_file" && ! "${_server_only[(r)${_file:t}]}" ]] && source "$_file"
done
unset _file _server_only

# -----------------------------
# SSH-agent plugin
# -----------------------------
zstyle :omz:plugins:ssh-agent agent-forwarding on
zstyle :omz:plugins:ssh-agent identities id_rsa

# -----------------------------
# Turbo loading: everything below is deferred until just AFTER the first prompt is drawn
# (wait"0a" -> "0b" -> "0c" run in that order), so the prompt appears immediately.
# -----------------------------

# Zoxide (smart cd replacement, cmd: j)
zinit ice wait"0a" lucid as'null' from"gh-r" sbin
zinit light ajeetdsouza/zoxide
zinit ice wait"0a" lucid has'zoxide'
zinit light z-shell/zsh-zoxide

# Completion stack. fzf-tab must load after compinit but BEFORE fast-syntax-highlighting.
zinit wait"0a" lucid for \
    atinit"ZINIT[COMPINIT_OPTS]=-C; zicompinit; zicdreplay" blockf \
    light-mode zsh-users/zsh-completions \
    chitoku-k/fzf-zsh-completions \
    Aloxaf/fzf-tab \
    zdharma-continuum/fast-syntax-highlighting

# OMZP core plugins
zinit wait"0b" lucid light-mode for \
  OMZP::"command-not-found" OMZP::"common-aliases" \
  OMZP::"docker-compose" OMZP::"extract" OMZP::"nmap" \
  OMZP::"pip" OMZP::"rsync" OMZP::"sudo" OMZP::"systemd" \
  OMZP::"taskwarrior" OMZP::"vagrant" OMZP::"virtualenv" OMZP::"web-search" \
  "zsh-users/zsh-history-substring-search" \
  "rummik/zsh-tailf" \
  OMZP::"cp" # cp with rsync -> call cpv

# brew only on systems where it is available
(( $+commands[brew] )) && zinit wait"0b" lucid light-mode for OMZP::"brew"

# Git / Forgit / AWS / Conda / Translate
# Disable default forgit aliases (conflict with grc); custom aliases in ~/.alias_forgit
export FORGIT_NO_ALIASES=True

zinit wait"0b" lucid light-mode for \
  "OMZ::plugins/git-extras/git-extras.plugin.zsh" \
  "wfxr/forgit" \
  "fdw/ranger-zoxide" \
  "eastokes/aws-plugin-zsh" \
  "esc/conda-zsh-completion" \
  "soimort/translate-shell"

# User aliases LAST, so they override the plugin aliases above (common-aliases, git-extras,
# ...). Also runs ~/.alias, which is large and forks (`git config`) — keep it off the
# critical path to the first prompt. The `null` plugin is just a hook to run atload at wait"0c".
zinit ice wait"0c" lucid atload'[[ -f ~/.alias_forgit ]] && source ~/.alias_forgit; [[ -f ~/.alias ]] && source ~/.alias; unalias jq 2>/dev/null'
zinit light zdharma-continuum/null

# -----------------------------
# FZF (lazy preview, faster)
# -----------------------------

if (( $+commands[fd] )); then
    export FZF_DEFAULT_COMMAND="fd" # CTRL-T's command
    # for more info see fzf/shell/completion.zsh
    _fzf_compgen_path() {
        fd . "$1"
    }
    _fzf_compgen_dir() {
        fd --type d . "$1"
    }
fi

export FZF_NETCDF_UUID_REGEXP="[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
export FZF_DEFAULT_OPTS="
--info=inline
--height=80%
--multi
--preview '
    ( (echo {} | grep -q -E \"\.nc$\") && ncdump -h {}) || \
    ( (echo {} | grep -q -E \"\.nc\..*\") && ncdump -h {}) || \
    ( (echo {} | grep -q -E \"\.zip$\") && zip -sf {}) || \
    ( (echo {} | grep -q -E \"\.zip\.$FZF_NETCDF_UUID_REGEX\") && zip -sf {}) || \
    ( (echo {} | grep -q -E \"\.(log|xml|txt)$\") && bat {}) || \
    ( (echo {} | grep -q -E \"\.(log|xml|txt)\..*\") && bat {}) || \
    ( [[ -f {} ]] && (bat --style=numbers --color=always {} || cat {})) || \
    ( [[ -d {} ]] && (tree -C {} | less)) || \
    echo {} 2> /dev/null | head -200'
--color='hl:148,hl+:154,pointer:032,marker:010,bg+:237,gutter:008'
--prompt='∼ ' --pointer='▶' --marker='✓'
--bind '?:toggle-preview'
--bind 'alt-a:select-all'
--bind 'alt-d:deselect-all'
--bind 'alt-t:toggle-all'
--bind 'alt-y:execute-silent(echo {+} | xclip -sel clip)'
--bind 'alt-e:execute(nvim {+}  > /dev/tty)'
--bind 'alt-v:execute(code {+})'
"

export FORGIT_FZF_DEFAULT_OPTS="
--ansi
--prompt='∼ ' --pointer='▶' --marker='✓'
--border
--cycle
--reverse
--height '80%'
"


export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND --type f -LHI" # ALT-C's command
export FZF_ALT_C_COMMAND="$FZF_DEFAULT_COMMAND --type d"
export FZF_CTRL_T_OPTS="--select-1 --exit-0"
#
# -----------------------------
# TLDR formatting
# -----------------------------
export TLDR_HEADER='magenta bold underline'
export TLDR_QUOTE='italic'
export TLDR_DESCRIPTION='green'
export TLDR_CODE='red'
export TLDR_PARAM='blue'

# -----------------------------
# Keybindings
# -----------------------------
bindkey "\033[1~" beginning-of-line
bindkey "\033[4~" end-of-line
bindkey "^[[3~" delete-char

# FZF shortcuts
bindkey -s '^e' 'vim $(fd -LIH --type f | fzf -m --preview "([[ -f {} ]] && (bat --style=numbers --color=always {} || cat {}))")\n'
bindkey -s '^n' 'ncdump -t $(fd -HI -e nc | fzf -m --preview "([[ -f {} ]] && ncdump -h {})") | less\n'

# -----------------------------
# Source completions
# -----------------------------
# (compinit handled by zicompinit in turbo block above)
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' menu select
# _git stops after the first tag with matches (common-commands), hiding aliases like co-wip; offer those two together (all-commands repeats aliases)
zstyle ':completion:*:*:git:*' tag-order 'common-commands alias-commands' all-commands

# -----------------------------
# Optional utilities
# -----------------------------
[ -f ~/.cheat/fzf.bash ] && source ~/.cheat/fzf.bash

# Cache fzf shell integration — regenerate only when fzf binary changes
if (( $+commands[fzf] )); then
    _fzf_cache="$HOME/.cache/zsh/fzf_init.zsh"
    _fzf_bin="${commands[fzf]}"
    if [[ ! -f "$_fzf_cache" || "$_fzf_bin" -nt "$_fzf_cache" ]]; then
        mkdir -p "${_fzf_cache:h}"
        fzf --zsh >| "$_fzf_cache"
    fi
    source "$_fzf_cache"
    unset _fzf_cache _fzf_bin
elif [ -f ~/.fzf.zsh ]; then
    source ~/.fzf.zsh
fi
# Cache tldr completions — regenerate only when tldr binary changes (same pattern as gh)
if [[ -f ~/bin/tldr ]]; then
    _tldr_comp="$HOME/.cache/zsh/tldr_completions"
    if [[ ! -f "$_tldr_comp" || ~/bin/tldr -nt "$_tldr_comp" ]]; then
        mkdir -p "${_tldr_comp:h}"
        tldr --list 2>/dev/null >| "$_tldr_comp"
    fi
    compctl -k "($(< $_tldr_comp))" tldr
    unset _tldr_comp
fi

# rbenv — lazy init to avoid startup cost
if (( $+commands[rbenv] )); then
    rbenv() {
        unfunction rbenv 2>/dev/null
        eval "$(command rbenv init - zsh)"
        rbenv "$@"
    }
fi

# Cache gh completions — regenerate only when gh binary changes
if (( $+commands[gh] )); then
    _gh_comp="$HOME/.zsh_alias/_gh"
    _gh_bin=$(command -v gh)
    if [[ ! -f "$_gh_comp" || "$_gh_bin" -nt "$_gh_comp" ]]; then
        gh completion -s zsh > "$_gh_comp" && chmod +x "$_gh_comp"
    fi
    unset _gh_comp _gh_bin
fi

# Show my own alias descriptions (see bin/gh-aliases) in `gh <TAB>`.
# The cobra completion script calls `gh __complete ...`, which resolves to this function.
gh() {
    if [[ $1 == __complete && $# -eq 2 ]]; then
        command gh "$@" | awk -F'\t' -v descs="$(command gh-aliases 2>/dev/null)" '
            BEGIN { n = split(descs, L, "\n"); for (i = 1; i <= n; i++) { k = L[i]; sub(/ .*/, "", k); d = L[i]; sub(/^[^ ]+ +/, "", d); if (k != "" && d != "") D[k] = d } }
            ($1 in D) && NF >= 2 { print $1 "\t" D[$1]; next }
            { print }'
    else
        command gh "$@"
    fi
}

# Show my own alias descriptions (see bin/git-alias) in `git <TAB>`.
# zsh's _git lists aliases via `git help --aliases-for-completion` (NUL-separated "name\nexpansion").
git() {
    if [[ $1 == help && $2 == --aliases-for-completion ]]; then
        local -A _desc
        local _l _rec _name _text _out
        for _l in ${(f)"$(command git-alias 2>/dev/null)"}; do
            read -r _name _text <<< "$_l"
            _desc[$_name]=$_text
        done
        for _rec in ${(0)"$(command git help --aliases-for-completion)"}; do
            _name=${_rec%%$'\n'*}
            _out+="${_name}"$'\n'"${_desc[$_name]:-${_rec#*$'\n'}}"$'\0'
        done
        print -rn -- "$_out"
    else
        command git "$@"
    fi
}

# Long-lived tmux panes keep a stale forwarded-agent socket; ~/.ssh/rc maintains a stable symlink
# to the current one on each ssh login, so follow it at every prompt (remote sessions only).
if [[ -n $SSH_CONNECTION || -n $TMUX ]]; then
    _follow_ssh_agent() { [[ -S $HOME/.ssh/ssh_auth_sock ]] && export SSH_AUTH_SOCK=$HOME/.ssh/ssh_auth_sock }
    autoload -Uz add-zsh-hook && add-zsh-hook precmd _follow_ssh_agent
fi

# ------------------------
# SSH autocomplete
# ------------------------

# Better SSH/Rsync/SCP Autocomplete
zstyle ':completion:*:(scp|rsync):*' tag-order ' hosts:-ipaddr:ip\ address hosts:-host:host files'
zstyle ':completion:*:(ssh|scp|rsync):*:hosts-host' ignored-patterns '*(.|:)*' loopback ip6-loopback localhost ip6-localhost broadcasthost
zstyle ':completion:*:(ssh|scp|rsync):*:hosts-ipaddr' ignored-patterns '^(<->.<->.<->.<->|(|::)([[:xdigit:].]##:(#c,2))##(|%*))' '127.0.0.<->' '255.255.255.255' '::1' 'fe80::*'

# Hide system accounts (_flatpak, geoclue, ...) from the user@host completion; offer only my own user
zstyle ':completion:*:(ssh|scp|sftp|rsync):*' users "$USER" root



