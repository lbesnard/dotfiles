# Enable profiling: ZSH_PROFILE=1 zsh
[[ -n $ZSH_PROFILE ]] && zmodload zsh/zprof

# -----------------------------
# Machine profile: termux | server | homeserver | laptop
# Override with ZSH_PROFILE_NAME=<profile> (e.g. in ~/.zshenv) if detection is wrong.
# -----------------------------
if [[ -z $ZSH_PROFILE_NAME ]]; then
  if [[ -n $TERMUX_VERSION || $PREFIX == *com.termux* ]]; then
    ZSH_PROFILE_NAME=termux
  else
    case "$HOST" in
      *aws*|*nec*|ip-[0-9]*-[0-9]*) ZSH_PROFILE_NAME=server ;;  # ip-172-31-x-x = default EC2 hostname
      dev|*funk*|*-X202EP*)    ZSH_PROFILE_NAME=homeserver ;;  # dev = docker-dev container (nested under laptop's C-a, so C-b)
      *) [[ $USER == ubuntu ]] && ZSH_PROFILE_NAME=homeserver || ZSH_PROFILE_NAME=laptop ;;
    esac
  fi
fi
export ZSH_PROFILE_NAME

# Termux is fully self-contained: no linuxbrew, no glibc binaries, minimal plugins.
if [[ $ZSH_PROFILE_NAME == termux ]]; then
  source $HOME/.zshrc.termux
  [[ -n $ZSH_PROFILE ]] && zprof
  return
fi

source $HOME/.zshrc.common

# Load zsh/stat once for fork-free symlink resolution below
zmodload zsh/stat 2>/dev/null

# _tmux_conf: point ~/.tmux.conf.local at $1 (laptop|ssh) unless it already does
_tmux_conf() {
  zstat -A REPLY +link ~/.tmux.conf.local 2>/dev/null
  [[ "$REPLY" != "$HOME/.tmux.conf.$1" ]] && ln -sf ~/.tmux.conf.$1 ~/.tmux.conf.local
}

case $ZSH_PROFILE_NAME in
  server)     source $HOME/.zshrc.server;     _tmux_conf ssh ;;
  homeserver) source $HOME/.zshrc.homeserver; _tmux_conf ssh ;;
  laptop)     source $HOME/.zshrc.laptop;     _tmux_conf laptop ;;
esac
unfunction _tmux_conf

# ~/.tmux.conf.ssh_laptop (prefix C-s) is available for nested-tmux use cases
# (e.g. outer tmux on laptop with C-a, inner tmux on server with C-s).
# To activate: ln -sf ~/.tmux.conf.ssh_laptop ~/.tmux.conf.local

# SDKMAN — lazy init (sdkman-init.sh is ~200-500ms; defer until first use)
export SDKMAN_DIR="$HOME/.sdkman"
if [[ -s "$SDKMAN_DIR/bin/sdkman-init.sh" ]]; then
    sdk() {
        unfunction sdk 2>/dev/null
        source "$SDKMAN_DIR/bin/sdkman-init.sh"
        sdk "$@"
    }
fi

# Lazy conda/mamba — subprocess spawned only on first use (~100-200ms saved per startup)
export PATH="$HOME/miniforge3/bin:$PATH"
_conda_init() {
    unfunction conda mamba 2>/dev/null
    eval "$("${CONDA_EXE:-$HOME/miniforge3/bin/conda}" shell.zsh hook 2>/dev/null)"
}
conda() { _conda_init; conda "$@"; }
mamba() { _conda_init; mamba "$@"; }

# Lazy thefuck — eval deferred to first invocation
if (( $+commands[thefuck] )); then
    fuck() {
        unfunction fuck 2>/dev/null
        eval $(thefuck --alias)
        fuck "$@"
    }
fi

# Nix
[ -e "$HOME/.nix-profile/etc/profile.d/nix.sh" ] && source "$HOME/.nix-profile/etc/profile.d/nix.sh"

# Byte-compile the rc files in the background when they change (symlinks in $HOME, so
# the .zwc files land next to the links and never touch the repo).
{
  for _f in ~/.zshrc ~/.zshrc.common ~/.zshrc.laptop ~/.zshrc.server; do
    [[ -f $_f && ( ! -f $_f.zwc || $_f -nt $_f.zwc ) ]] && zcompile $_f 2>/dev/null
  done
} &!

# Set display if it's not already defined
if [ -z "$DISPLAY" ]; then
    export DISPLAY=:0
fi

[[ -n $ZSH_PROFILE ]] && zprof
