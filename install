#!/usr/bin/env bash

set -e

DOTBOT_DIR="dotbot"
DOTBOT_BIN="bin/dotbot"
BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# # Minimum neovim version required for LazyVim
# NVIM_MIN_MAJOR=0
# NVIM_MIN_MINOR=11
#
# nvim_is_new_enough() {
#   if ! command -v nvim &>/dev/null; then
#     return 1
#   fi
#   local version
#   version=$(nvim --version 2>/dev/null | head -1 | grep -oP '\d+\.\d+\.\d+' | head -1)
#   local major minor
#   major=$(echo "$version" | cut -d. -f1)
#   minor=$(echo "$version" | cut -d. -f2)
#   if [[ "$major" -gt "$NVIM_MIN_MAJOR" ]] ||
#     [[ "$major" -eq "$NVIM_MIN_MAJOR" && "$minor" -ge "$NVIM_MIN_MINOR" ]]; then
#     return 0
#   fi
#   return 1
# }
#
# if nvim_is_new_enough; then
#   CONFIG="install.conf.yaml"
#   echo "Neovim >= 0.${NVIM_MIN_MINOR} detected — installing full config (vim + neovim/LazyVim)"
# else
#   CONFIG="install_legacy.conf.yaml"
#   echo "Neovim < 0.${NVIM_MIN_MINOR} or not found — installing legacy config (vim only, no neovim)"
# fi
#
#
CONFIG="install.conf.yaml"
cd "${BASEDIR}"
git submodule update --init --recursive --depth 1 "${BASEDIR}"

# --- migrate Nextcloud/Joplin dirs ---------------------------------------------
# They used to be symlinks into this repo (-> dotfiles_private). Only their config files are linked now, and a
# symlinked dir would make dotbot delete the repo's own decrypted file. Turn them into real dirs, keeping state.
migrate_appdir() {  # <dir under ~/.config> <legacy dir under dotfiles_private>
  local d="$HOME/.config/$1" tgt src tmp
  [ -L "$d" ] || return 0
  # match the executable name (argv[0]) only: a browser with a nextcloud URL must not count as the app running
  if pgrep -i -f "^([^ ]*/)?${1%%-*}[^ /]*( |\$)" >/dev/null 2>&1; then
    echo "install: $1 looks like it is running; quit it and re-run ./install to convert $d" >&2; return 0
  fi
  tgt="$(readlink -f "$d")"; src="$tgt"
  [ -d "$(dirname "${BASEDIR}")/dotfiles_private/$2" ] && src="$(dirname "${BASEDIR}")/dotfiles_private/$2"
  echo "install: converting $d from a symlink into a real directory (state copied from $src)"
  tmp="$d.new"; rm -rf "$tmp"
  if cp -a "$src/." "$tmp" 2>/dev/null || { mkdir -p "$tmp"; true; }; then rm "$d" && mv "$tmp" "$d"; fi
}
migrate_appdir Nextcloud Nextcloud
migrate_appdir joplin-desktop joplin-desktop

# dotbot exits non-zero if any link failed; do not let `set -e` skip the secrets step below.
dotbot_rc=0
"${BASEDIR}/${DOTBOT_DIR}/${DOTBOT_BIN}" -d "${BASEDIR}" -c "${CONFIG}" "${@}" || dotbot_rc=$?

# --- secrets (age) -----------------------------------------------------------
# With the age key (~/.config/age/key.txt): decrypt *.age and link the secret files.
# Without it: public dotfiles only, with a warning. Never fails the install.
# Offers (interactively) to install zerobrew/age/pre-commit and to paste the age key.
"${BASEDIR}/secrets" bootstrap || true
"${BASEDIR}/secrets" install-hook || true
rc=0
"${BASEDIR}/secrets" decrypt || rc=$?
if [ "$rc" -eq 0 ]; then
  "${BASEDIR}/${DOTBOT_DIR}/${DOTBOT_BIN}" -d "${BASEDIR}" -c install.private.conf.yaml "${@}"
elif [ "$rc" -ne 2 ]; then
  echo "secrets: decrypt had problems (rc=$rc); private links skipped. See above." >&2
fi
"${BASEDIR}/secrets" install-completion || true
echo
"${BASEDIR}/secrets" status || true

if [ "$dotbot_rc" -ne 0 ]; then
  echo "install: dotbot reported failed links (rc=$dotbot_rc); see the output above." >&2
  exit "$dotbot_rc"
fi
