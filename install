#!/usr/bin/env bash

set -e

DOTBOT_DIR="dotbot"
DOTBOT_BIN="bin/dotbot"
BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# # Minimum neovim version required for LazyVim
# NVIM_MIN_MAJOR=0
# NVIM_MIN_MINOR=11
#
# nvim_is_new_enough() {
#   if ! command -v nvim &>/dev/null; then
#     return 1
#   fi
#   local version
#   version=$(nvim --version 2>/dev/null | head -1 | grep -oP '\d+\.\d+\.\d+' | head -1)
#   local major minor
#   major=$(echo "$version" | cut -d. -f1)
#   minor=$(echo "$version" | cut -d. -f2)
#   if [[ "$major" -gt "$NVIM_MIN_MAJOR" ]] ||
#     [[ "$major" -eq "$NVIM_MIN_MAJOR" && "$minor" -ge "$NVIM_MIN_MINOR" ]]; then
#     return 0
#   fi
#   return 1
# }
#
# if nvim_is_new_enough; then
#   CONFIG="install.conf.yaml"
#   echo "Neovim >= 0.${NVIM_MIN_MINOR} detected — installing full config (vim + neovim/LazyVim)"
# else
#   CONFIG="install_legacy.conf.yaml"
#   echo "Neovim < 0.${NVIM_MIN_MINOR} or not found — installing legacy config (vim only, no neovim)"
# fi
#
#
CONFIG="install.conf.yaml"
cd "${BASEDIR}"
git submodule update --init --recursive --depth 1 "${BASEDIR}"

# dotbot exits non-zero if any link failed; do not let `set -e` skip the secrets step below.
dotbot_rc=0
"${BASEDIR}/${DOTBOT_DIR}/${DOTBOT_BIN}" -d "${BASEDIR}" -c "${CONFIG}" "${@}" || dotbot_rc=$?

# --- secrets (age) -----------------------------------------------------------
# With the age key (~/.config/age/key.txt): decrypt *.age and link the secret files.
# Without it: public dotfiles only, with a warning. Never fails the install.
# Offers (interactively) to install zerobrew/age/pre-commit and to paste the age key.
"${BASEDIR}/secrets" bootstrap || true
"${BASEDIR}/secrets" install-hook || true
rc=0
"${BASEDIR}/secrets" decrypt || rc=$?
if [ "$rc" -eq 0 ]; then
  "${BASEDIR}/${DOTBOT_DIR}/${DOTBOT_BIN}" -d "${BASEDIR}" -c install.private.conf.yaml "${@}"
elif [ "$rc" -ne 2 ]; then
  echo "secrets: decrypt had problems (rc=$rc); private links skipped. See above." >&2
fi
echo
"${BASEDIR}/secrets" status || true

if [ "$dotbot_rc" -ne 0 ]; then
  echo "install: dotbot reported failed links (rc=$dotbot_rc); see the output above." >&2
  exit "$dotbot_rc"
fi
