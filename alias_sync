)

function funk_rsync() {
    local server_ip="$1"; shift
    local folder_to_bckp="$1"; shift
    local src="/data/$folder_to_bckp"
    local dest="$1/$folder_to_bckp"; shift

    mkdir -p "$dest"
    [ -d "$dest" ] && rsync -auvh -P --delete-after --delete-excluded \
        -e "ssh -i ~/.ssh/id_rsa -p 9000 -l root" \
        "$server_ip:$src/" "$dest/" \
        --stats --progress \
        "${_funk_rsync_excludes[@]}" \
        "$@" || echo "$dest does not exist"
}

_ensure_ssh_key_loaded() {
    export SSH_AUTH_SOCK="$HOME/.ssh/ssh-agent.sock"

    ssh-add -l &> /dev/null
    local ssh_exit_code=$?

    if [ $ssh_exit_code -eq 2 ] || [[ ! -S "$SSH_AUTH_SOCK" ]]; then
        echo "SSH agent unreachable or socket dead. Restarting..."
        rm -f "$SSH_AUTH_SOCK"
        eval "$(ssh-agent -s -a "$SSH_AUTH_SOCK")" > /dev/null
    fi

    if ! ssh-add -l &> /dev/null; then
        echo "No SSH keys loaded. Running ssh-add..."
        ssh-add -t 10h
    fi
}

function funk_rclone() {
    _ensure_ssh_key_loaded
    local server_ip="$1"; shift
    local folder_to_bckp="$1"; shift
    local dest_root="$1"; shift
    local src="/data/$folder_to_bckp"
    local dest="$dest_root/$folder_to_bckp"

    mkdir -p "$dest"

    # --sftp-ssh bypasses rclone's built-in SSH client entirely; rclone ignores
    # ALL connection params (host/port/user/ciphers) from the connection string —
    # they must all live in the ssh command itself (see rclone docs example).
    #
    # ControlMaster multiplexes all rclone worker subprocesses over ONE TCP
    # connection, so the server never hits MaxStartups regardless of concurrency.
    # ServerAliveInterval keeps that single master connection alive through NAT.
    local ctl="/tmp/rclone-funk-$server_ip"
    local sftp_ssh="ssh -p 9000 -l backup"
    sftp_ssh+=" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
    sftp_ssh+=" -o Ciphers=aes128-gcm@openssh.com"
    sftp_ssh+=" -o ServerAliveInterval=60 -o ServerAliveCountMax=5"
    sftp_ssh+=" -o ControlMaster=auto -o ControlPath=$ctl -o ControlPersist=600"
    sftp_ssh+=" $server_ip"

    if [ -d "$dest" ]; then
        rclone sync ":sftp:$src" "$dest" \
            --progress \
            --sftp-ssh "$sftp_ssh" \
            --sftp-idle-timeout 0 \
            --transfers 4 \
            --checkers 16 \
            --buffer-size 16M \
            --retries 10 \
            --retries-sleep 30s \
            --low-level-retries 20 \
            --delete-after \
            --track-renames \
            --exclude "**/.XDG/**" \
            --exclude "**/*.sock" \
            --exclude "**/*-runtime" \
            --exclude ".*lrprev" \
            --exclude "jellyfin/**" \
            --exclude "uploaded_piwigo/**" \
            --exclude "piwigo/**" \
            --exclude "*.tmp" \
            --exclude "*.jpg_original*" \
            --exclude "docker_photoprism/**" \
            --exclude "photoprism/**" \
            --exclude "komga/logs/**" \
            --exclude "komga/lucene/**" \
            --exclude "komga/artemis/**" \
            --exclude ".bazarr.log.*" \
            --exclude "lidarr/logs/**" \
            --exclude "radarr/logs/**" \
            --exclude "radarr_fr/logs/**" \
            --exclude "MediaCover/**" \
            --exclude "Navidrome/cache/**" \
            --exclude "*.log" \
            --exclude "*.log.*.gz" \
            --exclude "*.page" \
            --exclude "*.amq" \
            --exclude ".deleted" \
            "$@"
    else
        echo "Error: $dest could not be created."
    fi
}

function funk_rsync_config() {
    if ! command -v jq &>/dev/null; then
        echo "Error: 'jq' is not installed. Please install it and try again."
        return 1
    fi
    if ! command -v fzf &>/dev/null; then
        echo "Error: 'fzf' is not installed. Please install it and try again."
        return 1
    fi

    local config_file; config_file="$(_funk_config_file)"
    if [[ ! -f "$config_file" ]]; then
        echo "Error: Configuration file '$config_file' not found."
        return 1
    fi

    local fzf_lines=() dest sync_info
    while IFS= read -r task_name; do
        dest=$(jq -r --arg t "$task_name" '.tasks[] | select(.name == $t) | .destination' "$config_file")
        _funk_dest_is_available "$dest" || continue
        sync_info=$(_funk_last_sync_info "$task_name")
        fzf_lines+=("${task_name}  │  ${sync_info}")
    done < <(jq -r '.tasks[].name' "$config_file")

    if [[ ${#fzf_lines[@]} -eq 0 ]]; then
        echo "No tasks with available destinations found."
        return 1
    fi

    local selected_line
    selected_line=$(printf '%s\n' "${fzf_lines[@]}" | fzf --prompt="Select a task: " --height=15 --border --ansi)
    [[ -z "$selected_line" ]] && { echo "No task selected. Exiting."; return 1; }

    local selected_task
    selected_task=$(echo "$selected_line" | awk -F'  │  ' '{print $1}')

    local server_ip folder_to_bckp dest
    server_ip=$(jq -r --arg task "$selected_task" 'first(.tasks[] | select(.name == $task) | .server)' "$config_file")
    folder_to_bckp=$(jq -r --arg task "$selected_task" 'first(.tasks[] | select(.name == $task) | .source)' "$config_file")
    dest=$(jq -r --arg task "$selected_task" 'first(.tasks[] | select(.name == $task) | .destination)' "$config_file")

    local extra_rsync_options=()
    while IFS= read -r line; do
        extra_rsync_options+=("$line")
    done < <(jq -r --arg task "$selected_task" 'first(.tasks[] | select(.name == $task)) | .rsync_options[]' "$config_file")

    funk_rsync "$server_ip" "$folder_to_bckp" "$dest" "${extra_rsync_options[@]}" "$@"
    local exit_code=$?
    [[ $exit_code -eq 0 ]] && _funk_record_sync "$selected_task"
    return $exit_code
}

function funk_rclone_config() {
    _ensure_ssh_key_loaded
    if ! command -v jq &>/dev/null || ! command -v fzf &>/dev/null; then
        echo "Error: 'jq' and 'fzf' are required."
        return 1
    fi

    local config_file; config_file="$(_funk_config_file)"
    if [[ ! -f "$config_file" ]]; then
        echo "Error: Configuration file '$config_file' not found."
        return 1
    fi

    local fzf_lines=() dest sync_info
    while IFS= read -r task_name; do
        dest=$(jq -r --arg t "$task_name" '.tasks[] | select(.name == $t) | .destination' "$config_file")
        _funk_dest_is_available "$dest" || continue
        sync_info=$(_funk_last_sync_info "$task_name")
        fzf_lines+=("${task_name}  │  ${sync_info}")
    done < <(jq -r '.tasks[].name' "$config_file")

    if [[ ${#fzf_lines[@]} -eq 0 ]]; then
        echo "No tasks with available destinations found."
        return 1
    fi

    local selected_line
    selected_line=$(printf '%s\n' "${fzf_lines[@]}" | fzf --prompt="Select a task: " --height=15 --border)
    [[ -z "$selected_line" ]] && return 1

    local selected_task
    selected_task=$(echo "$selected_line" | awk -F'  │  ' '{print $1}')

    local server_ip folder_to_bckp dest
    server_ip=$(jq -r --arg task "$selected_task" 'first(.tasks[] | select(.name == $task) | .server)' "$config_file")
    folder_to_bckp=$(jq -r --arg task "$selected_task" 'first(.tasks[] | select(.name == $task) | .source)' "$config_file")
    dest=$(jq -r --arg task "$selected_task" 'first(.tasks[] | select(.name == $task) | .destination)' "$config_file")

    local extra_options=()
    while IFS= read -r line; do
        extra_options+=("$line")
    done < <(jq -r --arg task "$selected_task" 'first(.tasks[] | select(.name == $task)) | .rclone_options[]' "$config_file")

    print -P "%F{green}❯ $selected_task%f"
    funk_rclone "$server_ip" "$folder_to_bckp" "$dest" "${extra_options[@]}" "$@"
    local exit_code=$?
    [[ $exit_code -eq 0 ]] && _funk_record_sync "$selected_task"
    return $exit_code
}

function funk_rsync_cron() {
    local out_machine="$1"
    local config_file; config_file="$(_funk_config_file)"

    if [[ -z "$out_machine" ]]; then
        echo "Usage: funk_rsync_cron <out_machine_name>"
        return 1
    fi
    if ! command -v jq &>/dev/null; then
        echo "Error: 'jq' is not installed."
        return 1
    fi
    if [[ ! -f "$config_file" ]]; then
        echo "Error: Configuration file '$config_file' not found."
        return 1
    fi

    jq -c --arg out_machine "$out_machine" \
        '.tasks[] | select(.name | test("OUT:" + $out_machine + "$"))' "$config_file" | \
    while read -r task_json; do
        local name
        name=$(jq -r '.name' <<< "$task_json")

        local disable
        disable=$(jq -r '.disable_auto_rsync // false' <<< "$task_json")
        if [[ "$disable" == "true" ]]; then
            echo "[$name] Skipping (disable_auto_rsync is true)"
            continue
        fi

        local server_ip folder_to_bckp dest src target
        server_ip=$(jq -r '.server' <<< "$task_json")
        folder_to_bckp=$(jq -r '.source' <<< "$task_json")
        dest=$(jq -r '.destination' <<< "$task_json")
        src="/data/$folder_to_bckp"
        target="$dest/$folder_to_bckp"

        mkdir -p "$target"

        local extra_rsync_options=()
        while IFS= read -r line; do
            extra_rsync_options+=("$line")
        done < <(jq -r '.rsync_options[]?' <<< "$task_json")

        local rsync_base=(
            rsync -auvh -P --delete-after --delete-excluded
            -e "ssh -i ~/.ssh/id_rsa -p 9000 -l root"
            "${extra_rsync_options[@]}"
            --stats --progress
            "${_funk_rsync_excludes[@]}"
        )

        echo "[$name] Running dry-run..."
        if "${rsync_base[@]}" --dry-run "$server_ip:$src/" "$target/"; then
            echo "[$name] Dry-run succeeded. Starting sync..."
            if "${rsync_base[@]}" --bwlimit 1500 "$server_ip:$src/" "$target/"; then
                _funk_record_sync "$name"
            fi
        else
            echo "[$name] Dry-run failed. Skipping task."
        fi
    done
}

