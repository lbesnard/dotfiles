}

mount_efunknuc_pics() {
    mkdir -p "$HOME/beefunk_pictures"
    local ip
    ip=$(getent hosts efunknuc.lan | awk '{print $1}')
    sudo mount -t nfs -o nfsvers=3,proto=tcp,nolock,addr=efunknuc.lan efunknuc.lan:/media/beefunk_12tb_1/pictures "$HOME/beefunk_pictures"
}

mount_best_pics() {
    mkdir -p "$HOME/beefunk_pictures"

    local host1="beefunk.lan"
    local ip1
    ip1=$(getent hosts "$host1" | awk '{print $1}')
    local path1="$ip1:/media/lbesnard/beefunk_12tb_c/pictures"

    local host2="efunknuc.lan"
    local ip2
    ip2=$(getent hosts "$host2" | awk '{print $1}')
    local path2="$ip2:/media/beefunk_12tb_1/pictures"

    local rtt1 rtt2
    rtt1=$(ping -c 1 -W 1 "$host1" 2>/dev/null | awk -F'/' 'END {print $5}')
    rtt1=${rtt1:-9999}
    rtt2=$(ping -c 1 -W 1 "$host2" 2>/dev/null | awk -F'/' 'END {print $5}')
    rtt2=${rtt2:-9999}

    local target_host target_path
    local faster
    faster=$(awk -v r1="$rtt1" -v r2="$rtt2" 'BEGIN {if (r1+0 < r2+0) print "1"; else print "2"}')

    if [[ "$faster" == "1" ]]; then
        target_host="$host1"
        target_path="$path1"
    else
        target_host="$host2"
        target_path="$path2"
    fi

    local ip
    ip=$(getent hosts "$target_host" | awk '{print $1}')
    echo "Connecting to the fastest server: $target_host ($ip)..."
    sudo mount -t nfs -o nfsvers=3,proto=tcp,nolock,soft,timeo=30,retrans=2,addr="$ip" "$target_path" "$HOME/beefunk_pictures"
}

