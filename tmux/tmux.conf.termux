# Termux local config for Oh my tmux! (~/.tmux.conf.local -> this file)
# Same look and keys as the servers (tmux.conf.ssh, prefix C-b), plus phone tweaks below.
# Needs (pkg install): tmux perl. Clipboard: pkg install termux-api + the Termux:API app.

source-file ~/.tmux.conf.ssh

# -- phone overrides -----------------------------------------------------------
tmux_conf_new_session_prompt=false       # no prompt when creating a session
tmux_conf_copy_to_os_clipboard=false     # oh-my-tmux only knows xclip/xsel/wl-copy; see termux-clipboard-set below
tmux_conf_update_plugins_on_launch=false
tmux_conf_update_plugins_on_reload=false

set -g mouse on                          # touch scrolling / selecting
set -g pane-border-status off            # save a row on a small screen
set -g default-shell zsh

# Yank to the Android clipboard when termux-api is installed
if-shell 'command -v termux-clipboard-set' \
    'bind -T copy-mode-vi y send -X copy-pipe-and-cancel "termux-clipboard-set"; bind -T copy-mode-vi Enter send -X copy-pipe-and-cancel "termux-clipboard-set"'
