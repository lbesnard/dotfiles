#!/usr/bin/env bash
# secrets <encrypt|decrypt|status|check|install-hook> [--force] [--stage]
#
# Secrets listed in secrets.list live as gitignored plaintext; only <file>.age is committed.
# Encrypts to the public keys in recipients.txt; decrypts with ~/.config/age/key.txt ($AGE_KEY).
#
#   encrypt        re-encrypt plaintext that changed (--stage: also `git add` the .age files)
#   decrypt        write plaintext from .age files (never clobbers local edits unless --force)
#   status         key / hook / per-file state
#   check          pre-commit guard: refuse staged plaintext or non-age *.age files
#   install-hook   `pre-commit install`, or print how to get it
#   bootstrap      interactive: offer to install zerobrew + age + pre-commit, and to paste the age key
#
# Exit codes of decrypt: 0 ok, 2 no key (public-only install), 1 error/conflict.
set -uo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
cd "$ROOT"
KEY="${AGE_KEY:-$HOME/.config/age/key.txt}"
STATE="$(git rev-parse --git-path secrets-state 2>/dev/null || echo .git/secrets-state)"
umask 077

say()  { printf '%s\n' "$*"; }
warn() { printf 'secrets: %s\n' "$*" >&2; }
list() { grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' secrets.list; }
have_key() { [ -r "$KEY" ]; }
need_age() { command -v age >/dev/null || { warn "age not found (apt install age / brew install age)"; return 1; }; }
sha() { sha256sum "$1" | cut -d' ' -f1; }
stamp() { echo "$STATE/${1//\//__}"; }
record() { mkdir -p "$STATE"; sha "$1" >"$(stamp "$1")"; }
dec() { age -d -i "$KEY" "$1.age" 2>/dev/null; }   # plaintext to stdout

cmd_encrypt() {
  need_age || return 1
  local stage=0 force=0 rc=0 f changed=()
  for a in "$@"; do [ "$a" = --stage ] && stage=1; [ "$a" = --force ] && force=1; done
  while read -r f; do
    [ -f "$f" ] || continue
    if ! git check-ignore -q -- "$f"; then
      warn "REFUSING: $f is not gitignored; add it to .gitignore first"; rc=1; continue
    fi
    if [ -f "$f.age" ]; then
      if have_key; then
        dec "$f" | cmp -s - "$f" && continue          # unchanged: age output is random, don't churn the diff
      elif [ "$force" = 0 ]; then
        warn "no key: cannot tell if $f changed, skipping (use --force to re-encrypt)"; continue
      fi
    fi
    age -R recipients.txt -o "$f.age.tmp" "$f" && mv "$f.age.tmp" "$f.age" || { rc=1; continue; }
    record "$f"; changed+=("$f.age"); say "encrypted $f"
  done < <(list)
  if [ "$stage" = 1 ] && [ ${#changed[@]} -gt 0 ]; then
    git add -- "${changed[@]}"
    warn "re-encrypted and staged: ${changed[*]}"
    warn "run the commit again to include them."
    return 1        # make pre-commit stop once, so the commit contains the new ciphertext
  fi
  return $rc
}

cmd_decrypt() {
  local force=0 rc=0 f plain tmp
  [ "${1:-}" = --force ] && force=1
  if ! have_key; then
    warn "NO AGE KEY at $KEY -> public dotfiles only, secrets skipped."
    warn "copy your key from KeePass to $KEY (chmod 600), then run: ./secrets decrypt"
    return 2
  fi
  need_age || return 1
  while read -r f; do
    [ -f "$f.age" ] || { warn "missing $f.age"; rc=1; continue; }
    tmp="$(mktemp "$f.XXXXXX")" || { rc=1; continue; }
    if ! age -d -i "$KEY" -o "$tmp" "$f.age" 2>/dev/null; then
      rm -f "$tmp"; warn "cannot decrypt $f.age (wrong key?)"; rc=1; continue
    fi
    if [ -f "$f" ] && [ ! -L "$f" ]; then
      if cmp -s "$tmp" "$f"; then rm -f "$tmp"; record "$f"; continue; fi
      if [ "$force" = 0 ] && [ "$(sha "$f")" != "$(cat "$(stamp "$f")" 2>/dev/null)" ]; then
        rm -f "$tmp"; warn "CONFLICT $f has local edits not yet encrypted; kept it (./secrets decrypt --force to overwrite)"; rc=1; continue
      fi
    fi
    mkdir -p "$(dirname "$f")"; chmod 600 "$tmp"; mv -f "$tmp" "$f"; record "$f"; say "decrypted $f"
  done < <(list)
  return $rc
}

cmd_status() {
  local f s hooks bad=0
  if have_key; then say "key:   $KEY ok (pubkey $(age-keygen -y "$KEY" 2>/dev/null | cut -c1-16)...)"
  else say "key:   MISSING ($KEY) - secrets cannot be decrypted or re-encrypted"; bad=1; fi
  hooks="$(git rev-parse --git-path hooks)"
  if [ -f "$hooks/pre-commit" ] && grep -q pre-commit "$hooks/pre-commit"; then say "hook:  pre-commit installed"
  else say "hook:  NOT INSTALLED - plaintext secrets are not guarded on commit (./secrets install-hook)"; bad=1; fi
  while read -r f; do
    if [ ! -f "$f.age" ]; then s="no .age file"
    elif [ ! -f "$f" ]; then s="not decrypted"
    elif ! git check-ignore -q -- "$f"; then s="PLAINTEXT NOT GITIGNORED"; bad=1
    elif have_key && dec "$f" | cmp -s - "$f"; then s="in sync"
    elif have_key; then s="plaintext differs from .age (will re-encrypt on commit)"
    else s="present (cannot compare without key)"; fi
    printf '  %-40s %s\n' "$f" "$s"
  done < <(list)
  return $bad
}

cmd_check() {   # called by pre-commit with staged file names
  local f bad=0 secrets
  secrets="$(list)"
  for f in "$@"; do
    if grep -Fxq -- "$f" <<<"$secrets"; then warn "PLAINTEXT SECRET staged: $f"; bad=1; fi
    case "$f" in *.age) [ -f "$f" ] && { head -c 21 "$f" | grep -q '^age-encryption.org/v1' || { warn "NOT AN AGE FILE: $f"; bad=1; }; } ;; esac
  done
  return $bad
}

cmd_bootstrap() {
  # Interactive only; silently does nothing without a terminal.
  [ -t 1 ] && [ -r /dev/tty ] || return 0
  export PATH="$HOME/.local/bin:$HOME/.local/share/zerobrew/prefix/bin:$PATH"
  local missing=() a line key="" pub
  command -v age >/dev/null || missing+=(age)
  command -v pre-commit >/dev/null || missing+=(pre-commit)
  if [ ${#missing[@]} -gt 0 ]; then
    warn "missing tools: ${missing[*]}"
    read -r -p "secrets: install them with zerobrew (curl -fsSL https://zerobrew.rs/install | bash)? [Y/n] " a </dev/tty
    case "$a" in
      ""|y|Y|yes)
        command -v zb >/dev/null || curl -fsSL https://zerobrew.rs/install | bash -s -- --no-modify-path || { warn "zerobrew install failed"; return 1; }
        export PATH="$HOME/.local/bin:$HOME/.local/share/zerobrew/prefix/bin:$PATH"
        zb install "${missing[@]}" || warn "zb install failed" ;;
      *) warn "skipped; secrets stay locked until age is installed" ;;
    esac
  fi
  if command -v age-keygen >/dev/null && ! have_key; then
    warn "no age key at $KEY"
    say "Paste your age key from KeePass (the AGE-SECRET-KEY-1... line is enough), or press Enter to skip:"
    stty -echo </dev/tty 2>/dev/null
    while IFS= read -r line </dev/tty; do
      [ -z "$line" ] && [ -z "$key" ] && break
      key+="$line"$'\n'
      case "$line" in AGE-SECRET-KEY-1*) break ;; esac
    done
    stty echo </dev/tty 2>/dev/null; echo
    [ -n "$key" ] || { warn "no key entered; public dotfiles only"; return 0; }
    pub="$(printf '%s' "$key" | age-keygen -y 2>/dev/null)" || { warn "that is not a valid age key; not saved"; return 1; }
    if grep -Fxq -- "$pub" recipients.txt; then
      mkdir -p "$(dirname "$KEY")" && chmod 700 "$(dirname "$KEY")"
      printf '%s' "$key" >"$KEY" && chmod 600 "$KEY" && say "key saved to $KEY"
    else
      warn "valid key, but its public key ($pub) is not in recipients.txt; not saved"; return 1
    fi
  fi
}

cmd_install_hook() {
  if command -v pre-commit >/dev/null; then
    pre-commit install >/dev/null && say "pre-commit hook installed"
  else
    warn "pre-commit not found: secrets are NOT guarded on commit."
    warn "install it (pipx install pre-commit / brew install pre-commit) then run: ./secrets install-hook"
    return 1
  fi
}

c="${1:-status}"; shift || true
case "$c" in
  encrypt) cmd_encrypt "$@" ;;
  decrypt) cmd_decrypt "$@" ;;
  status) cmd_status ;;
  check) cmd_check "$@" ;;
  install-hook) cmd_install_hook ;;
  bootstrap) cmd_bootstrap ;;
  *) sed -n '2,15p' "${BASH_SOURCE[0]}"; exit 1 ;;
esac
