#!/usr/bin/env bash
# secrets <encrypt|decrypt|status|check|install-hook> [--force] [--stage]
#
# Secrets flagged in manifest.list live as gitignored plaintext; only <file>.age is committed.
# Encrypts to the public keys in recipients.txt; decrypts with ~/.config/age/key.txt ($AGE_KEY).
#
#   encrypt        re-encrypt plaintext that changed (--stage: `git add` them and stop once, for pre-commit;
#                  --add: `git add` them and carry on, for the native git hook)
#   decrypt        write plaintext from .age files (never clobbers local edits unless --force;
#                  --quiet: silent unless something changed; --hook: verbose, for git hooks)
#   status         key / hook / per-file state
#   check          pre-commit guard: refuse staged plaintext or non-age *.age files
#   install-hook   `pre-commit install`, or print how to get it
#   install-completion  link the zsh completion into your fpath
#   bootstrap      interactive: offer to install zerobrew + age + pre-commit, and to paste the age key
#
# Exit codes of decrypt: 0 ok, 2 no key (public-only install), 1 error/conflict.
set -uo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
cd "$ROOT"
# zerobrew installs outside the default PATH; every invocation needs it, not just bootstrap.
export PATH="$HOME/.local/bin:$HOME/.local/share/zerobrew/prefix/bin:$PATH"
KEY="${AGE_KEY:-$HOME/.config/age/key.txt}"
STATE="$(git rev-parse --git-path secrets-state 2>/dev/null || echo .git/secrets-state)"
umask 077

say()  { printf '%s\n' "$*"; }
warn() { printf 'secrets: %s\n' "$*" >&2; }
HOST="$(hostname -s | tr '[:upper:]' '[:lower:]')"   # lowercase: same name on every OS/case
_list() {   # the `secret` rows of manifest.list; a row with * expands to existing files (plaintext or only .age)
  local p g
  while read -r p; do
    case "$p" in
      *\**) for g in $p $p.age; do [ -e "$g" ] && echo "${g%.age}"; done ;;
      *) echo "$p" ;;
    esac
  done < <(awk '$1!~/^#/ && $3=="secret"{print $1}' manifest.list) | sort -u
}
# a listed secret must be gitignored; add the (host-globbed) pattern ourselves instead of making you edit .gitignore
ensure_ignored() {
  git check-ignore -q -- "$1" && return 0
  local p; while read -r p; do
    # shellcheck disable=SC2254
    case "$1" in $p) echo "/$p" >>.gitignore; say "gitignore: added /$p"; git check-ignore -q -- "$1"; return;; esac
  done < <(list_glob)
  return 1
}
# {hostname} in manifest.list = this machine only, so other machines' files are never expected here
list() { _list | sed "s/{hostname}/$HOST/g"; }
hostlist() { _list | grep -F '{hostname}' | sed "s/{hostname}/$HOST/g"; }   # per-machine rows: absent until this machine creates them
list_glob() { _list | sed 's/{hostname}/*/g'; }   # any host: used to refuse staging any machine's plaintext
have_key() { [ -r "$KEY" ]; }
need_age() { command -v age >/dev/null || { warn "age not found (apt install age / brew install age)"; return 1; }; }
sha() { sha256sum "$1" | cut -d' ' -f1; }
stamp() { echo "$STATE/${1//\//__}"; }
record() { mkdir -p "$STATE"; sha "$1" >"$(stamp "$1")"; }
dec() { age -d -i "$KEY" "$1.age" 2>/dev/null; }   # plaintext to stdout

cmd_encrypt() {
  need_age || return 1
  local stage=0 add=0 force=0 rc=0 f changed=() same=0
  local only=()
  for a in "$@"; do
    case "$a" in --stage) stage=1 ;; --add) add=1 ;; --force) force=1 ;; -*) ;; *) only+=("${a#./}") ;; esac
  done
  for a in "${only[@]}"; do   # a path you name must be a listed secret, else say so instead of silently doing nothing
    list | grep -Fxq -- "$a" || { warn "$a is not a secret in manifest.list for host '$HOST' (add a row with the flag: secret)"; rc=1; }
  done
  while read -r f; do
    [ -f "$f" ] || continue
    [ ${#only[@]} -gt 0 ] && ! printf '%s\n' "${only[@]}" | grep -Fxq -- "$f" && continue
    if ! ensure_ignored "$f"; then
      warn "REFUSING: $f is not gitignored and could not be added to .gitignore"; rc=1; continue
    fi
    if [ -f "$f.age" ]; then
      if have_key; then
        dec "$f" | cmp -s - "$f" && { same=$((same+1)); continue; }   # unchanged: age output is random, don't churn the diff
      elif [ "$force" = 0 ]; then
        warn "no key: cannot tell if $f changed, skipping (use --force to re-encrypt)"; continue
      fi
    fi
    age -R recipients.txt -o "$f.age.tmp" "$f" && mv "$f.age.tmp" "$f.age" || { rc=1; continue; }
    record "$f"; changed+=("$f.age"); say "encrypted $f"
  done < <(list)
  # summary: always when run by hand, only when something happened when run by a git hook
  if [ "$stage" = 0 ] && [ "$add" = 0 ]; then
    say "encrypt: ${#changed[@]} encrypted, $same unchanged"
    [ ${#changed[@]} -gt 0 ] && say "next: git add -A && git commit  (the .age files are what gets committed)"
  fi
  if [ "$stage" = 1 ] && [ ${#changed[@]} -gt 0 ]; then
    git add -- "${changed[@]}"
    warn "re-encrypted and staged: ${changed[*]}"
    warn "run the commit again to include them."
    return 1        # make pre-commit stop once, so the commit contains the new ciphertext
  fi
  if [ "$add" = 1 ] && [ ${#changed[@]} -gt 0 ]; then git add -- "${changed[@]}"; fi
  return $rc
}

cmd_decrypt() {
  local force=0 quiet=0 hook=0 rc=0 f plain tmp a upd=0 same=0
  for a in "$@"; do [ "$a" = --force ] && force=1; [ "$a" = --quiet ] && quiet=1; [ "$a" = --hook ] && hook=1; done
  if ! have_key; then
    [ "$quiet" = 1 ] && return 0          # silent
    if [ "$hook" = 1 ]; then say "secrets: no age key at $KEY, secrets not refreshed (public dotfiles only)"; return 0; fi
    warn "NO AGE KEY at $KEY -> public dotfiles only, secrets skipped."
    warn "copy your key from KeePass to $KEY (chmod 600), then run: ./secrets decrypt"
    return 2
  fi
  need_age || return 1
  [ "$hook" = 1 ] && say "secrets: refreshing decrypted secrets after pull..."
  while read -r f; do
    if [ ! -f "$f.age" ]; then
      hostlist | grep -Fxq -- "$f" && continue          # new machine: its own file does not exist yet (not an error)
      warn "missing $f.age"; rc=1; continue
    fi
    tmp="$(mktemp "$f.XXXXXX")" || { rc=1; continue; }
    if ! age -d -i "$KEY" -o "$tmp" "$f.age" 2>/dev/null; then
      rm -f "$tmp"; warn "cannot decrypt $f.age (wrong key?)"; rc=1; continue
    fi
    if [ -f "$f" ] && [ ! -L "$f" ]; then
      if cmp -s "$tmp" "$f"; then rm -f "$tmp"; record "$f"; same=$((same+1)); continue; fi
      if [ "$force" = 0 ] && [ "$(sha "$f")" != "$(cat "$(stamp "$f")" 2>/dev/null)" ]; then
        rm -f "$tmp"; warn "CONFLICT $f has local edits not yet encrypted; kept it (./secrets decrypt --force to overwrite)"; rc=1; continue
      fi
    fi
    mkdir -p "$(dirname "$f")"; chmod 600 "$tmp"; mv -f "$tmp" "$f"; record "$f"; upd=$((upd+1)); say "decrypted $f"
  done < <(list)
  if [ "$quiet" = 0 ] || [ "$upd" -gt 0 ] || [ "$rc" -ne 0 ]; then   # --hook is not --quiet: always report
    say "decrypt: $upd updated, $same unchanged$([ "$rc" -ne 0 ] && echo ", some skipped (see above)")"
  fi
  if [ "$hook" = 1 ] && [ -x bin/link-manifest ]; then   # new manifest rows / host files pulled in: (re)link, report only problems
    bin/link-manifest 2>&1 | grep -v -e '^linked:' -e '^ok:' || true
  fi
  return $rc
}

cmd_status() {
  local f s hooks bad=0
  if have_key; then say "key:   $KEY ok (pubkey $(age-keygen -y "$KEY" 2>/dev/null | cut -c1-16)...)"
  else say "key:   MISSING ($KEY) - secrets cannot be decrypted or re-encrypted"; bad=1; fi
  hooks="$(git rev-parse --git-path hooks)"
  if [ -f "$hooks/pre-commit" ] && grep -q -e pre-commit -e 'secrets install-hook' "$hooks/pre-commit"; then say "hook:  installed ($(grep -q 'secrets install-hook' "$hooks/pre-commit" && echo native || echo pre-commit))"
  else say "hook:  NOT INSTALLED - plaintext secrets are not guarded on commit (./secrets install-hook)"; bad=1; fi
  while read -r f; do
    if [ ! -f "$f.age" ]; then s="no .age file"
    elif [ ! -f "$f" ]; then s="not decrypted"
    elif ! git check-ignore -q -- "$f"; then s="PLAINTEXT NOT GITIGNORED"; bad=1
    elif have_key && dec "$f" | cmp -s - "$f"; then s="in sync"
    elif have_key; then s="plaintext differs from .age (will re-encrypt on commit)"
    else s="present (cannot compare without key)"; fi
    printf '  %-40s %s\n' "$f" "$s"
  done < <(list)
  return $bad
}

cmd_check() {   # called by pre-commit with staged file names
  local f bad=0 p
  for f in "$@"; do
    while read -r p; do
      # shellcheck disable=SC2254
      case "$f" in $p) warn "PLAINTEXT SECRET staged: $f"; bad=1; break ;; esac
    done < <(list_glob)
    case "$f" in *.age) [ -f "$f" ] && { head -c 21 "$f" | grep -q '^age-encryption.org/v1' || { warn "NOT AN AGE FILE: $f"; bad=1; }; } ;; esac
  done
  return $bad
}

# Pythons that can run pre-commit. Conda first (usual on these machines), then the system one.
# Never zerobrew's: it needs a newer glibc than some machines have.
pythons() {
  local c
  for c in "${CONDA_PREFIX:-/nonexistent}/bin/python" "$HOME"/{miniforge3,miniconda3,anaconda3,mambaforge,micromamba}/bin/python /usr/bin/python3; do
    [ -x "$c" ] && "$c" -c 'import sys' >/dev/null 2>&1 && echo "$c"
  done
}
# Sets PC to a command that really runs pre-commit (PRE_COMMIT=none forces the plain git hook).
find_pc() {
  PC=(); [ "${PRE_COMMIT:-}" = none ] && return 1
  if "${PRE_COMMIT:-pre-commit}" --version >/dev/null 2>&1; then PC=("${PRE_COMMIT:-pre-commit}"); return 0; fi
  local py
  for py in $(pythons); do
    if "$py" -m pre_commit --version >/dev/null 2>&1; then PC=("$py" -m pre_commit); return 0; fi
  done
  return 1
}

cmd_bootstrap() {
  # Interactive only; silently does nothing without a terminal.
  [ -t 1 ] && [ -r /dev/tty ] || return 0
  export PATH="$HOME/.local/bin:$HOME/.local/share/zerobrew/prefix/bin:$PATH"
  local missing=() a line key="" pub
  command -v age >/dev/null || missing+=(age)
  if [ ${#missing[@]} -gt 0 ]; then
    warn "missing tools: ${missing[*]}"
    read -r -p "secrets: install them with zerobrew (curl -fsSL https://zerobrew.rs/install | bash)? [Y/n] " a </dev/tty
    case "$a" in
      ""|y|Y|yes)
        command -v zb >/dev/null || curl -fsSL https://zerobrew.rs/install | bash -s -- --no-modify-path || { warn "zerobrew install failed"; return 1; }
        export PATH="$HOME/.local/bin:$HOME/.local/share/zerobrew/prefix/bin:$PATH"
        zb install "${missing[@]}" || warn "zb install failed" ;;
      *) warn "skipped; secrets stay locked until age is installed" ;;
    esac
  fi
  # pre-commit: install with pip into conda (or the system Python); zerobrew's Python may not run here.
  if ! find_pc; then
    warn "pre-commit is missing or not working on this machine"
    read -r -p "secrets: install it with pip (pip install pre-commit)? [Y/n] " a </dev/tty
    case "$a" in
      ""|y|Y|yes)
        local py ok=0
        for py in $(pythons); do
          "$py" -m pip --version >/dev/null 2>&1 || continue
          if [ -d "$(dirname "$py")/../conda-meta" ]; then "$py" -m pip install pre-commit && ok=1   # conda env: no --user
          else "$py" -m pip install --user pre-commit && ok=1; fi
          [ "$ok" = 1 ] && break
        done
        [ "$ok" = 1 ] || { command -v pipx >/dev/null && pipx install pre-commit && ok=1; }
        [ "$ok" = 1 ] || warn "pip install failed (externally-managed system Python? try: pipx install pre-commit); using the plain git hook instead" ;;
      *) warn "skipped; a plain git hook will be used instead" ;;
    esac
  fi
  if command -v age-keygen >/dev/null && ! have_key; then
    warn "no age key at $KEY"
    say "Paste your age key from KeePass (the AGE-SECRET-KEY-1... line is enough), or press Enter to skip:"
    stty -echo </dev/tty 2>/dev/null
    while IFS= read -r line </dev/tty; do
      [ -z "$line" ] && [ -z "$key" ] && break
      key+="$line"$'\n'
      case "$line" in AGE-SECRET-KEY-1*) break ;; esac
    done
    stty echo </dev/tty 2>/dev/null; echo
    [ -n "$key" ] || { warn "no key entered; public dotfiles only"; return 0; }
    pub="$(printf '%s' "$key" | age-keygen -y 2>/dev/null)" || { warn "that is not a valid age key; not saved"; return 1; }
    if grep -Fxq -- "$pub" recipients.txt; then
      mkdir -p "$(dirname "$KEY")" && chmod 700 "$(dirname "$KEY")"
      printf '%s' "$key" >"$KEY" && chmod 600 "$KEY" && say "key saved to $KEY"
    else
      warn "valid key, but its public key ($pub) is not in recipients.txt; not saved"; return 1
    fi
  fi
}

cmd_install_completion() {
  # zsh only. The dotfiles link zsh/completions to ~/.zsh_complete, which is on $fpath; elsewhere, add a user dir.
  local src="$ROOT/zsh/completions/_secrets" dir d
  command -v zsh >/dev/null || { say "completion: zsh not installed, nothing to do"; return 0; }
  [ -f "$src" ] || { warn "missing $src"; return 1; }
  for d in "$HOME/.zsh_complete" "$HOME/.zsh/completions" "${XDG_DATA_HOME:-$HOME/.local/share}/zsh/site-functions"; do
    [ -d "$d" ] && [ -w "$d" ] && { dir="$d"; break; }
  done
  if [ -z "${dir:-}" ]; then dir="$HOME/.zsh_complete"; mkdir -p "$dir"; fi
  if [ "$(readlink -f "$dir/_secrets" 2>/dev/null)" = "$(readlink -f "$src")" ] || { [ -f "$dir/_secrets" ] && cmp -s "$dir/_secrets" "$src"; }; then
    say "completion: already installed in $dir"
  else
    ln -sf "$src" "$dir/_secrets" && say "completion: linked $dir/_secrets"
  fi
  if ! zsh -ic "print -l \$fpath" 2>/dev/null | grep -Fxq "$dir"; then
    warn "$dir is not on your zsh \$fpath; add this to ~/.zshrc: fpath=($dir \$fpath)"
  fi
  say "completion: open a new shell (or: rm -f ~/.zcompdump*; exec zsh) to pick it up"
}

write_hook() {   # <name> <script>; never overwrites someone else's hook
  local h="$hooks/$1"
  if [ -f "$h" ] && ! grep -q 'secrets install-hook' "$h"; then
    warn "a different $1 hook already exists at $h; not overwriting it"; return 1
  fi
  printf '%s\n' "$2" >"$h" && chmod +x "$h"
}

cmd_install_hook() {
  local hooks
  # Prefer the pre-commit framework when it actually runs (conda/pip, or on PATH).
  if find_pc && "${PC[@]}" install >/dev/null; then say "pre-commit hooks installed (${PC[*]}): pre-commit, post-merge, post-rewrite"; return 0; fi
  # Fallback: plain git hooks, no Python needed.
  hooks="$(git rev-parse --git-path hooks)"; mkdir -p "$hooks"
  write_hook pre-commit '#!/usr/bin/env bash
# installed by ./secrets install-hook (native fallback; used when the pre-commit framework is unavailable)
cd "$(git rev-parse --show-toplevel)" || exit 1
./secrets encrypt --add || exit 1
git diff --cached --name-only --diff-filter=ACMR -z | xargs -0 ./secrets check' || return 1
  write_hook post-merge '#!/usr/bin/env bash
# installed by ./secrets install-hook: refresh decrypted secrets after `git pull`
cd "$(git rev-parse --show-toplevel)" || exit 0
./secrets decrypt --hook || true' || return 1
  write_hook post-rewrite '#!/usr/bin/env bash
# installed by ./secrets install-hook: refresh decrypted secrets after `git pull --rebase`
[ "${1:-}" = rebase ] || exit 0
cd "$(git rev-parse --show-toplevel)" || exit 0
./secrets decrypt --hook || true' || return 1
  say "native git hooks installed: pre-commit, post-merge, post-rewrite (pre-commit framework not usable here)"
}

c="${1:-status}"; shift || true
[ $# -eq 0 ] && [ "$c" = status ] && [ -t 1 ] && say "usage: secrets status|encrypt|decrypt|install-hook|install-completion|bootstrap   (README: Secrets)"
case "$c" in
  encrypt) cmd_encrypt "$@" ;;
  decrypt) cmd_decrypt "$@" ;;
  status) cmd_status ;;
  check) cmd_check "$@" ;;
  install-hook) cmd_install_hook ;;
  bootstrap) cmd_bootstrap ;;
  install-completion) cmd_install_completion ;;
  *) sed -n '2,15p' "${BASH_SOURCE[0]}"; exit 1 ;;
esac
