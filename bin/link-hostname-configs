#!/usr/bin/env bash
# Link hostname-specific config files to their canonical ~/.config/ locations.
#
# Convention: store configs as  config/APP/name.{hostname}.ext  (or name.{hostname}
# for extension-less files) and list it in manifest.list (one line per app).
#
# Mark credentials files `secret` in manifest.list: ./secrets then encrypts + gitignores them.
#
# To add a new machine:
#   cp ~/.config/APP/file  ~/.dotfiles/config/APP/file.$(hostname -s | tr A-Z a-z)[.ext]
#   git add config/APP/file.$(hostname -s | tr A-Z a-z)[.ext]
#   ./secrets encrypt   # only if the line is marked `secret` in manifest.list
#   git commit && git push

set -uo pipefail

HOST=$(hostname -s | tr '[:upper:]' '[:lower:]')
DOTFILES="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

_link() {
    local src="${DOTFILES}/${1/\{hostname\}/$HOST}"
    local target="$2"

    if [[ -f "$src" ]]; then
        mkdir -p "$(dirname "$target")"
        ln -sfn "$src" "$target"
        printf 'linked:  %s\n' "$target"
    else
        printf 'MISSING: %s\n  fix:  cp %s %s\n' "$src" "$target" "$src"
        printf '         then: git add + commit'
        awk -v p="$1" '$1==p && $3=="secret"{f=1} END{exit !f}' "$DOTFILES/manifest.list" \
            && printf ' (./secrets encrypt first — file is sensitive)'
        printf '\n'
    fi
}

while read -r src target flag; do
    _link "$src" "${target/#\~/$HOME}"
done < <(awk '$1!~/^#/ && $1~/[{]hostname[}]/ && $2!="-"' "$DOTFILES/manifest.list")
