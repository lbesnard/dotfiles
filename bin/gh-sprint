#!/usr/bin/env bash
# My items in the current sprint of a GitHub Project.
# Usage: gh-sprint [list|pick]
#   list  (default) coloured table sorted by priority
#   pick  fzf picker: ENTER opens in browser, CTRL-T imports into Taskwarrior
# Env: GH_ORG (aodn), GH_PROJECT (90)
set -euo pipefail

ORG="${GH_ORG:-aodn}"
PROJECT="${GH_PROJECT:-90}"
mode="${1:-list}"

fetch() {
  gh project item-list "$PROJECT" --owner "$ORG" --format json \
    --query "assignee:@me iteration:@current -status:Done -status:Closed"
}

list() {
  fetch | jq -r '
    def color_prio(raw; padded):
      if raw == "High" then "\u001b[31m" + padded + "\u001b[0m"
      elif raw == "Medium" then "\u001b[33m" + padded + "\u001b[0m"
      elif raw == "Low" then "\u001b[32m" + padded + "\u001b[0m"
      else "\u001b[90m" + padded + "\u001b[0m" end;
    def pad(len): tostring | . + " " * (len - length);
    def prio_weight:
      if . == "High" then 1 elif . == "Medium" then 2 elif . == "Low" then 3 else 4 end;

    (.items | map(.project // "No-Project") | unique) as $unique_projects |
    [34, 35, 36, 94, 95, 96, 37, 90] as $palette |
    (reduce range(0; $unique_projects | length) as $i
      ({}; . + {($unique_projects[$i]): $palette[$i % ($palette | length)]})) as $color_map |

    (.items | sort_by(.priority | prio_weight))[] |
    ((.iteration.title // "No-Iter") | pad(15)) as $iter |
    (.priority // "None") as $raw_prio |
    ($raw_prio | pad(8)) as $prio_pad |
    (.project // "No-Project") as $pjt_raw |
    ($pjt_raw | pad(18)) as $pjt_pad |
    ((.content.number // "DRAFT") | tostring | pad(6)) as $num |
    (.content.url // "") as $url |
    "\u001b[\($color_map[$pjt_raw])m\($pjt_pad)\u001b[0m" as $pjt_colored |
    "[\($iter)]  \(color_prio($raw_prio; $prio_pad))  \($pjt_colored)  #\($num)  \(.content.title)  \u001b[90m\($url)\u001b[0m"
  '
}

pick() {
  # "|" as delimiter: tab is IFS whitespace, so `read` would collapse empty fields
  local out key
  out="$(fetch | jq -r '
      def color_prio(p):
        if p == "High" then "\u001b[31m" + p + "\u001b[0m"
        elif p == "Medium" then "\u001b[33m" + p + "\u001b[0m"
        elif p == "Low" then "\u001b[32m" + p + "\u001b[0m"
        else "\u001b[90mNone\u001b[0m" end;
      .items[] |
      (.iteration.title // "No-Iteration") as $iter |
      (.priority // "None") as $prio |
      (.project // "No-Project") as $pjt |
      "\($iter)|\(color_prio($prio))|\u001b[36m\($pjt)\u001b[0m|\(.content.number // "DRAFT")|\(.content.title)|\(.content.repository // "none")"
    ' | sort -rV |
    fzf --ansi --reverse --multi \
      --header "TAB: Select | ENTER: Open | CTRL-T: Taskwarrior" \
      --expect=ctrl-t --delimiter '\|' --with-nth 1,2,3,4,5 \
      --preview-window 'right:60%:wrap' \
      --preview 'gh issue view {4} -R {6}')" || return 0

  [ -n "$out" ] || return 0
  key="$(head -n 1 <<<"$out")"

  tail -n +2 <<<"$out" | perl -pe 's/\e\[[0-9;]*m//g' |
  while IFS='|' read -r _ prio pjt num title repo; do
    { [ -z "$num" ] || [ "$num" = "DRAFT" ] || [ "$repo" = "none" ]; } && continue

    if [ "$key" = "ctrl-t" ]; then
      tw_prio="$(cut -c1 <<<"$prio" | tr '[:lower:]' '[:upper:]')"
      case "$tw_prio" in H|M|L) ;; *) tw_prio="" ;; esac

      echo "📥 Importing #$num: $title"
      url="$(gh issue view "$num" -R "$repo" --json url --jq .url)"
      pjt="$(perl -pe 's/\b(\w)/\U$1/g; s/\s+//g' <<<"$pjt")"
      task add "$title ($url)" project:"Work.$pjt" priority:"$tw_prio" due:today +today +github
    else
      echo "🌐 Opening #$num in browser..."
      gh issue view "$num" -R "$repo" --web
    fi
  done
}

case "$mode" in
  list) list ;;
  pick) pick ;;
  *) echo "Usage: gh sprint [list|pick]" >&2; exit 1 ;;
esac
