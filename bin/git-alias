#!/usr/bin/env bash
# List git aliases with the "# description" comment above each in the [alias] section.
cfg="${GIT_ALIAS_CONFIG:-$HOME/.gitconfig}"
awk '
/^\[/ {in_a = ($0 == "[alias]"); next}
in_a && /^[ \t]*# / {sub(/^[ \t]*# */,""); desc=$0; next}
in_a && /^[ \t]+[A-Za-z][A-Za-z0-9_-]* *=/ {
  name=$1; printf "%-26s %s\n", name, desc; desc=""
}' "$cfg" | sort
